# Intent Operating Layer (IOL) - Environment Configuration Template

# Environment & Server Settings
IOL_ENV=production
IOL_DEBUG=false
IOL_HOST=0.0.0.0
IOL_PORT=8000

# Database Configuration (PostgreSQL preferred for durable persistence)
DATABASE_URL=postgresql+psycopg://iol_user:iol_secure_pass_2026@localhost:5432/iol_db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Background Worker Settings
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_SECONDS=0.5

# Execution Budget Defaults
DEFAULT_MAX_DURATION_SECONDS=300.0
DEFAULT_MAX_STEPS=20
DEFAULT_MAX_COST_USD=1.00
DEFAULT_RETRY_LIMIT=2

# Security Boundaries
# Autonomous live outbound email dispatch is strictly blocked without human operator cryptographic sign-off
ALLOW_LIVE_EMAIL_DISPATCH=false
MAX_RESPONSE_BYTES=2000000

# Operator Timezone for Morning Arrival Calculations
OPERATOR_TIMEZONE=Asia/Kolkata
